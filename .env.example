# Importar en Vercel: Project → Settings → Environment Variables → Import
# o: vercel env pull / pegar este archivo al crear el proyecto.
# Sustituye los valores; no subas este archivo con secretos reales al repo.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
AUTH_SECRET=genera-con-openssl-rand-base64-32
AUTH_URL=https://lambda-score-sdd.vercel.app
APP_URL=https://lambda-score-sdd.vercel.app
EMAIL_FROM=avisos@tudominio.com
RESEND_API_KEY=re_xxxxxxxx

